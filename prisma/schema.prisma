generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String      @id @default(cuid())
  email            String      @unique
  passwordHash     String
  name             String
  image            String?     @db.Text
  createdAt        DateTime    @default(now())
  currency         String      @default("PKR")
  selfPersonId     String?     @unique
  personalExpenses Expense[]   @relation("PersonalExpenses")
  people           Person[]    @relation("OwnedPeople")
  selfPerson       Person?     @relation("SelfPerson", fields: [selfPersonId], references: [id])
  workspaces       Workspace[]
  categories       Category[]        @relation("OwnedCategories")
  accounts         Account[]
  transfers        AccountTransfer[]
  deposits         AccountDeposit[]
  udharEntries     UdharEntry[]
  notes            Note[]
}

model Person {
  id              String            @id @default(cuid())
  ownerId         String
  name            String
  email           String?
  image           String?           @db.Text
  isSelf          Boolean           @default(false)
  createdAt       DateTime          @default(now())
  payments        ExpensePayment[]
  splits          ExpenseSplit[]
  owner           User              @relation("OwnedPeople", fields: [ownerId], references: [id])
  settlementsFrom Settlement[]      @relation("SettlementFrom")
  settlementsTo   Settlement[]      @relation("SettlementTo")
  selfOf          User?             @relation("SelfPerson")
  memberships     WorkspaceMember[]
  udharEntries    UdharEntry[]
}

model Workspace {
  id          String            @id @default(cuid())
  ownerId     String
  name        String
  createdAt   DateTime          @default(now())
  expenses    Expense[]
  settlements Settlement[]
  owner       User              @relation(fields: [ownerId], references: [id])
  members     WorkspaceMember[]
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  personId    String
  joinedAt    DateTime  @default(now())
  person      Person    @relation(fields: [personId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, personId])
}

model Expense {
  id          String           @id @default(cuid())
  amount      Decimal          @db.Decimal(10, 2)
  description String
  category    String?
  date        DateTime         @default(now())
  createdAt   DateTime         @default(now())
  workspaceId String?
  ownerId     String?
  accountId   String?
  owner       User?            @relation("PersonalExpenses", fields: [ownerId], references: [id])
  workspace   Workspace?       @relation(fields: [workspaceId], references: [id])
  account     Account?         @relation("AccountExpenses", fields: [accountId], references: [id])
  payments    ExpensePayment[]
  splits      ExpenseSplit[]
}

model ExpenseSplit {
  id          String  @id @default(cuid())
  expenseId   String
  personId    String
  shareAmount Decimal @db.Decimal(10, 2)
  expense     Expense @relation(fields: [expenseId], references: [id])
  person      Person  @relation(fields: [personId], references: [id])

  @@unique([expenseId, personId])
}

model ExpensePayment {
  id         String  @id @default(cuid())
  expenseId  String
  personId   String
  amountPaid Decimal @db.Decimal(10, 2)
  expense    Expense @relation(fields: [expenseId], references: [id])
  person     Person  @relation(fields: [personId], references: [id])

  @@unique([expenseId, personId])
}

model Settlement {
  id           String     @id @default(cuid())
  workspaceId  String?
  fromPersonId String
  toPersonId   String
  amount       Decimal    @db.Decimal(10, 2)
  date         DateTime   @default(now())
  note         String?
  batchId      String?
  accountId    String?
  fromPerson   Person     @relation("SettlementFrom", fields: [fromPersonId], references: [id])
  toPerson     Person     @relation("SettlementTo", fields: [toPersonId], references: [id])
  workspace    Workspace? @relation(fields: [workspaceId], references: [id])
  account      Account?   @relation("AccountSettlements", fields: [accountId], references: [id])
}

model Category {
  id        String   @id @default(cuid())
  ownerId   String
  name      String
  budget    Decimal? @default(1000) @db.Decimal(10, 2)
  icon      String?
  color     String?
  createdAt DateTime @default(now())

  owner User @relation("OwnedCategories", fields: [ownerId], references: [id])

  @@unique([ownerId, name])
}

model Account {
  id             String            @id @default(cuid())
  ownerId        String
  name           String
  type           String            @default("CASH") // CASH | BANK | WALLET | UDHAR_KHATA
  initialBalance Decimal           @default(0) @db.Decimal(10, 2)
  balance        Decimal           @default(0) @db.Decimal(10, 2)
  color          String?           @default("#0F5C53")
  icon           String?           @default("wallet")
  createdAt      DateTime          @default(now())

  owner          User              @relation(fields: [ownerId], references: [id])
  transfersFrom    AccountTransfer[] @relation("TransferFrom")
  transfersTo      AccountTransfer[] @relation("TransferTo")
  expenses         Expense[]         @relation("AccountExpenses")
  deposits         AccountDeposit[]  @relation("AccountDeposits")
  settlements      Settlement[]      @relation("AccountSettlements")
  udharEntries     UdharEntry[]      @relation("AccountUdhar")
  udharSettlements UdharEntry[]      @relation("AccountUdharSettled")

  @@unique([ownerId, name])
}

model AccountTransfer {
  id            String   @id @default(cuid())
  ownerId       String
  fromAccountId String
  toAccountId   String
  amount        Decimal  @db.Decimal(10, 2)
  note          String?
  date          DateTime @default(now())
  createdAt     DateTime @default(now())

  owner       User    @relation(fields: [ownerId], references: [id])
  fromAccount Account @relation("TransferFrom", fields: [fromAccountId], references: [id])
  toAccount   Account @relation("TransferTo", fields: [toAccountId], references: [id])
}

model AccountDeposit {
  id        String   @id @default(cuid())
  ownerId   String
  accountId String
  amount    Decimal  @db.Decimal(10, 2)
  source    String   @default("Salary") // Salary, Freelance, Gift, Deposit, Profit, Other
  note      String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  owner   User    @relation(fields: [ownerId], references: [id])
  account Account @relation("AccountDeposits", fields: [accountId], references: [id])
}

model UdharEntry {
  id              String    @id @default(cuid())
  ownerId         String
  personId        String
  type            String    // "LENA" (Maine Diye / Receivable) | "DENA" (Maine Liye / Payable)
  amount          Decimal   @db.Decimal(10, 2)
  note            String?
  date            DateTime  @default(now())
  isSettled       Boolean   @default(false)
  settledAt       DateTime?
  accountId       String?
  settleAccountId String?
  createdAt       DateTime  @default(now())

  owner         User     @relation(fields: [ownerId], references: [id])
  person        Person   @relation(fields: [personId], references: [id])
  account       Account? @relation("AccountUdhar", fields: [accountId], references: [id])
  settleAccount Account? @relation("AccountUdharSettled", fields: [settleAccountId], references: [id])
}

model Note {
  id        String   @id @default(cuid())
  ownerId   String
  title     String
  content   String   @db.Text
  category  String?  @default("General") // General, Financial, Reminder, Checklist, Agreement
  color     String?  @default("emerald") // emerald, amber, blue, purple, rose, slate
  isPinned  Boolean  @default(false)
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, date])
}

